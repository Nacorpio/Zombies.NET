{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_]+(/[a-z0-9_]+)*$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "pattern": "^[a-z0-9_]+:[a-z0-9_]+(/[a-z0-9_]+)*$"
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "item"
        ]
      }
    },
    "loot": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outfit": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stat": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "operation": {
            "enum": [
              "add",
              "multiply"
            ]
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "stat",
          "operation",
          "value"
        ]
      }
    }
  },
  "required": [
    "id"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
