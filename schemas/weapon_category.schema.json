{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_]+(/[a-z0-9_]+)*$"
    },
    "handling": {
      "type": "number"
    },
    "mounts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "handling"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
