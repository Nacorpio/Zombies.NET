{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_]+(/[a-z0-9_]+)*$"
    },
    "from": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_]+(/[a-z0-9_]+)*$"
    },
    "to": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_]+:[a-z0-9_]+(/[a-z0-9_]+)*$"
    },
    "removed": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "from"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
