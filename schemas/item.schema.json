{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_]+(/[a-z0-9_]+)*$"
    },
    "mass": {
      "type": "string"
    },
    "volume": {
      "type": "string"
    },
    "maxStack": {
      "type": "integer"
    },
    "edible": {
      "type": "boolean"
    },
    "drinkable": {
      "type": "boolean"
    },
    "onConsume": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effect": {
            "type": "string"
          },
          "chance": {
            "type": "number"
          }
        },
        "required": [
          "effect"
        ]
      }
    }
  },
  "required": [
    "id",
    "mass",
    "volume"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
